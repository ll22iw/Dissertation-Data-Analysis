import xarray as xr
import numpy as np
import matplotlib.pyplot as plt
import h5py

view_lon, view_lat = [296.02, 352.22], [-3.98, 24.33]
dates = [
    {"label": "13 Aug", "f_date": "20240812", "t_t": "2024-08-13T12:00:00", 
     "gpm": '3A-DAY.GPM.DPR.V3-20210628.20240813-S000000-E235959.226.V07C.HDF5'},
    {"label": "03 Sep", "f_date": "20240902", "t_t": "2024-09-03T12:00:00",
     "gpm": '3A-DAY.GPM.DPR.V3-20240808.20240903-S000000-E235959.247.V07D.HDF5'}
]

def get_stats(da, t):
    lon_name = 'longitude' if 'longitude' in da.coords else 'lon'
    lat_name = 'latitude' if 'latitude' in da.coords else 'lat'
    subset = da.sel(time=t, method='nearest').sel(
        {lon_name: slice(view_lon[0], view_lon[1]), 
         lat_name: slice(view_lat[0], view_lat[1])}
    )
    data = subset.values.flatten()
    return data[~np.isnan(data)]

for d in dates:
    t, s = d["t_t"], d["f_date"]
    
    ds_sw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208_ctrl.nc')
    ds_sw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208.nc')
    ds_lw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205_ctrl.nc')
    ds_lw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205.nc')
    ds_r_c  = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_4203_ctrl.nc')
    ds_r_s  = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_4203.nc')
    ds_ceres = xr.open_dataset('CERES_SYN1deg-1H_Terra-Aqua-NOAA20_Ed4.2_Subset_20240801-20241031.nc')

    try:
        with h5py.File(d["gpm"], 'r') as hf:
            gpm_raw = hf['GRID/precipRateMean'][0, 0, 0, :, :]
            gpm_stats = gpm_raw[(gpm_raw > 0.1) & (gpm_raw < 100)]
    except:
        gpm_stats = np.array([])

    fig, axs = plt.subplots(1, 3, figsize=(22, 6))

    v_sw = list(ds_sw_c.data_vars)[0]
    axs[0].hist(get_stats(ds_sw_c[v_sw], t), bins=40, alpha=0.4, label='FIXED', color='blue', density=True)
    axs[0].hist(get_stats(ds_sw_s[v_sw], t), bins=40, alpha=0.4, label='AEROSOL', color='orange', density=True)
    axs[0].hist(get_stats(ds_ceres["toa_sw_all_1h"], t), bins=40, histtype='step', linewidth=2, label='CERES (Sat)', color='black', density=True)

    v_lw = list(ds_lw_c.data_vars)[0]
    axs[1].hist(get_stats(ds_lw_c[v_lw], t), bins=40, alpha=0.4, label='FIXED', color='blue', density=True)
    axs[1].hist(get_stats(ds_lw_s[v_lw], t), bins=40, alpha=0.4, label='AEROSOL', color='orange', density=True)
    axs[1].hist(get_stats(ds_ceres["toa_lw_all_1h"], t), bins=40, histtype='step', linewidth=2, label='CERES (Sat)', color='black', density=True)

    v_r = list(ds_r_c.data_vars)[0]
    r_c = get_stats(ds_r_c[v_r], t) * 3600
    r_s = get_stats(ds_r_s[v_r], t) * 3600
    r_c = r_c[r_c > 0.1]; r_s = r_s[r_s > 0.1]
    
    bins = np.logspace(np.log10(0.1), np.log10(100), 35)
    axs[2].hist(r_c, bins=bins, alpha=0.4, label='FIXED', color='blue', density=True)
    axs[2].hist(r_s, bins=bins, alpha=0.4, label='AEROSOL', color='orange', density=True)
    if len(gpm_stats) > 0:
        axs[2].hist(gpm_stats, bins=bins, histtype='step', linewidth=2, label='GPM (Sat)', color='black', density=True)
        axs[2].set_xscale('log')

    for ax in axs:
        ax.legend(fontsize=12)
        ax.grid(alpha=0.2)
        ax.tick_params(labelsize=11)

    plt.tight_layout()
    plt.show()
