import xarray as xr
import numpy as np
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
from cartopy.mpl.gridliner import LONGITUDE_FORMATTER, LATITUDE_FORMATTER

view_lon, view_lat = [296.02, 352.22], [-3.98, 24.33]
dates = [
    {"label": "13 August", "f_date": "20240812", "t_t": "2024-08-13T12:00:00"},
    {"label": "03 September", "f_date": "20240902", "t_t": "2024-09-03T12:00:00"}
]

sw_lim, lw_lim = 400, 100

fig, axs = plt.subplots(2, 2, figsize=(18, 16), subplot_kw={'projection': ccrs.PlateCarree()})
plt.subplots_adjust(wspace=0.1, hspace=0.15, bottom=0.15)

for row, d in enumerate(dates):
    t, s = d["t_t"], d["f_date"]
    
    ds_sw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208_ctrl.nc')
    ds_sw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208.nc')
    ds_lw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205_ctrl.nc')
    ds_lw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205.nc')

    v_sw = list(ds_sw_s.data_vars)[0]
    v_lw = list(ds_lw_s.data_vars)[0]

    sw_impact = ds_sw_s[v_sw].sel(time=t, method='nearest') - \
                ds_sw_c[v_sw].sel(time=t, method='nearest')
    lw_impact = ds_lw_s[v_lw].sel(time=t, method='nearest') - \
                ds_lw_c[v_lw].sel(time=t, method='nearest')

    im_sw = axs[row, 0].pcolormesh(sw_impact.longitude, sw_impact.latitude, sw_impact,
                                  cmap='RdBu_r', vmin=-sw_lim, vmax=sw_lim, transform=ccrs.PlateCarree())
    im_lw = axs[row, 1].pcolormesh(lw_impact.longitude, lw_impact.latitude, lw_impact,
                                  cmap='RdBu_r', vmin=-lw_lim, vmax=lw_lim, transform=ccrs.PlateCarree())

    axs[row, 0].text(-0.25, 0.5, d['label'], transform=axs[row, 0].transAxes, 
                     va='center', ha='center', fontsize=22, fontweight='bold', rotation=90)

cbar_ax_sw = fig.add_axes([0.15, 0.08, 0.3, 0.02])
cb_sw = fig.colorbar(im_sw, cax=cbar_ax_sw, orientation='horizontal')
cb_sw.set_label('$\Delta$ Shortwave (W m$^{-2}$)', size=18, fontweight='bold')
cb_sw.ax.tick_params(labelsize=14)

cbar_ax_lw = fig.add_axes([0.55, 0.08, 0.3, 0.02])
cb_lw = fig.colorbar(im_lw, cax=cbar_ax_lw, orientation='horizontal')
cb_lw.set_label('$\Delta$ Longwave (W m$^{-2}$)', size=18, fontweight='bold')
cb_lw.ax.tick_params(labelsize=14)

titles = ["Shortwave (SOL - CTRL)", "Longwave (SOL - CTRL)"]
for j in range(2):
    axs[0, j].set_title(titles[j], fontsize=24, pad=20, fontweight='bold')

for i in range(2):
    for j in range(2):
        ax = axs[i, j]
        ax.coastlines(linewidth=1.5)
        ax.set_extent([view_lon[0], view_lon[1], view_lat[0], view_lat[1]], crs=ccrs.PlateCarree())
        
        gl = ax.gridlines(draw_labels=True, alpha=0.3, linestyle='--')
        gl.top_labels = False
        gl.right_labels = False
        gl.bottom_labels = True
        gl.left_labels = (j == 0)
        gl.xlabel_style = {'size': 16}
        gl.ylabel_style = {'size': 16}
        gl.xformatter = LONGITUDE_FORMATTER
        gl.yformatter = LATITUDE_FORMATTER

plt.show()
