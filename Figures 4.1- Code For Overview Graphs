import xarray as xr
import numpy as np
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
import netCDF4 as nc

view_lon = [296.02, 352.22]
view_lat = [-3.98, 24.33]

dates_to_plot = [
    {"label": "13 August 2024", "target_t": "2024-08-13T12:00:00", "file_date": "20240812"},
    {"label": "03 September 2024", "target_t": "2024-09-03T12:00:00", "file_date": "20240902"}
]

def get_smoothed_sat(ds, var, timestamp):
    data = ds[var].sel(time=timestamp, method="nearest")
    return data.interp(
        lon=np.linspace(view_lon[0], view_lon[1], 300),
        lat=np.linspace(view_lat[0], view_lat[1], 200)
    )

for date_info in dates_to_plot:
    t, s = date_info["target_t"], date_info["file_date"]
    
    ds_sw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208_ctrl.nc')
    ds_sw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_1208.nc')
    ds_lw_c = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205_ctrl.nc')
    ds_lw_s = xr.open_dataset(f'var_{s}_orcestra_km5p0_RAL3P3_2205.nc')
    ds_sat  = xr.open_dataset('CERES_SYN1deg-1H_Terra-Aqua-NOAA20_Ed4.2_Subset_20240801-20241031.nc')

    v_sw = list(ds_sw_c.data_vars)[0]
    v_lw = list(ds_lw_c.data_vars)[0]

    fig, axs = plt.subplots(2, 3, figsize=(22, 14), subplot_kw={'projection': ccrs.PlateCarree()})
    plt.suptitle(f"Radiation Comparison: {date_info['label']} (12:00 UTC)", fontsize=26, y=0.98)

    cbar_style = {'orientation': 'horizontal', 'pad': 0.07, 'shrink': 0.85, 'aspect': 30}
    cols = ["CTRL", "SOLINSOL", "SATELLITE (CERES)"]

    sw_opt = {'cmap': 'viridis', 'vmin': 0, 'vmax': 1000}
    im0 = ds_sw_c[v_sw].sel(time=t, method='nearest').plot(ax=axs[0,0], add_labels=False, add_colorbar=False, **sw_opt)
    im1 = ds_sw_s[v_sw].sel(time=t, method='nearest').plot(ax=axs[0,1], add_labels=False, add_colorbar=False, **sw_opt)
    sw_sat = get_smoothed_sat(ds_sat, "toa_sw_all_1h", t)
    im2 = axs[0,2].pcolormesh(sw_sat.lon, sw_sat.lat, sw_sat, shading='auto', **sw_opt)

    for j, im in enumerate([im0, im1, im2]):
        cb = fig.colorbar(im, ax=axs[0,j], **cbar_style)
        cb.set_label('SW Flux (W m⁻²)', fontsize=14)
        axs[0,j].set_title(cols[j], fontsize=18)

    lw_opt = {'cmap': 'magma', 'vmin': 100, 'vmax': 350}
    im3 = ds_lw_c[v_lw].sel(time=t, method='nearest').plot(ax=axs[1,0], add_labels=False, add_colorbar=False, **lw_opt)
    im4 = ds_lw_s[v_lw].sel(time=t, method='nearest').plot(ax=axs[1,1], add_labels=False, add_colorbar=False, **lw_opt)
    lw_sat = get_smoothed_sat(ds_sat, "toa_lw_all_1h", t)
    im5 = axs[1,2].pcolormesh(lw_sat.lon, lw_sat.lat, lw_sat, shading='auto', **lw_opt)

    for j, im in enumerate([im3, im4, im5]):
        cb = fig.colorbar(im, ax=axs[1,j], **cbar_style)
        cb.set_label('LW Flux (W m⁻²)', fontsize=14)

    for ax in axs.flat:
        ax.set_extent([view_lon[0], view_lon[1], view_lat[0], view_lat[1]], crs=ccrs.PlateCarree())
        ax.coastlines(linewidth=1.2)
        gl = ax.gridlines(draw_labels=True, alpha=0.2, linestyle='--')
        gl.top_labels = gl.right_labels = False
        gl.xlabel_style = {'size': 12}
        gl.ylabel_style = {'size': 12}

    plt.tight_layout(rect=[0, 0, 1, 0.96])
    plt.show()

f_rn_ctrl = 'var_20240812_orcestra_km5p0_RAL3P3_4203_ctrl.nc'
f_rn_sol  = 'var_20240812_orcestra_km5p0_RAL3P3_4203.nc'
f_gpm     = '3A-DAY.GPM.DPR.V3-20210628.20240813-S000000-E235959.226.V07C.HDF5'

ds_gpm = xr.open_dataset(f_gpm, group='GRID', engine='netcdf4')
data_gpm = ds_gpm['precipRateMean'].isel(phony_dim_4=0, phony_dim_5=0)
if 'phony_dim_6' in data_gpm.dims:
    data_gpm = data_gpm.isel(phony_dim_6=0)

data_gpm = data_gpm.rename({'phony_dim_7': 'lon', 'phony_dim_8': 'lat'})
lons = np.linspace(0.125, 359.875, 1440)
lats = np.linspace(-67.125, 67.125, 536)
data_gpm = data_gpm.assign_coords(lon=lons, lat=lats)
data_gpm = data_gpm.assign_coords(lon=(((data_gpm.lon + 180) % 360) - 180)).sortby('lon')
data_gpm = data_gpm.where(data_gpm >= 0)

ds_c = xr.open_dataset(f_rn_ctrl)
ds_s = xr.open_dataset(f_rn_sol)
v_m = list(ds_c.data_vars)[0]

fig, axs = plt.subplots(1, 3, figsize=(24, 8), subplot_kw={'projection': ccrs.PlateCarree()})
plt.suptitle(f"Rainfall Comparison: 13 August 2024 (12:00 UTC)", fontsize=26, y=0.98)

opt = {'cmap': 'Blues', 'vmin': 0.1, 'vmax': 10}
cbar_opt = {'orientation': 'horizontal', 'pad': 0.1, 'shrink': 0.8}

im_p0 = (ds_c[v_m].sel(time="2024-08-13T12:00:00", method='nearest') * 3600).plot(ax=axs[0], add_colorbar=False, **opt)
axs[0].set_title("CTRL", fontsize=20)

im_p1 = (ds_s[v_m].sel(time="2024-08-13T12:00:00", method='nearest') * 3600).plot(ax=axs[1], add_colorbar=False, **opt)
axs[1].set_title("SOLINSOL", fontsize=20)

im_p2 = axs[2].pcolormesh(data_gpm.lon, data_gpm.lat, data_gpm.T, shading='auto', transform=ccrs.PlateCarree(), **opt)
axs[2].set_title("SATELLITE (GPM DPR)", fontsize=20)

for i, im in enumerate([im_p0, im_p1, im_p2]):
    cb = fig.colorbar(im, ax=axs[i], **cbar_opt)
    cb.set_label('Rain Rate (mm/hr)', fontsize=14)
    axs[i].coastlines(linewidth=1.2)
    axs[i].set_extent([view_lon[0], view_lon[1], view_lat[0], view_lat[1]], crs=ccrs.PlateCarree())
    gl = axs[i].gridlines(draw_labels=True, alpha=0.1)
    gl.top_labels = gl.right_labels = False
    gl.xlabel_style = {'size': 12}
    gl.ylabel_style = {'size': 12}

plt.show()

